{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/botheredbybees/science-comic-pipeline/schema/storyboard.schema.json",
  "title": "Storyboard",
  "description": "A science-comic storyboard: the source paper, a ledger of claims that cite it, a cast, and an ordered sequence of beats made of panels. It says what happens and how much room each moment gets, not how it is laid out. Renderers and layouts read this file and never the paper itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meta",
    "cast",
    "claims",
    "beats"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "spine"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "left_out": {
          "type": "array",
          "description": "Parts of the source deliberately not covered, so a reader can judge coverage.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "authors",
            "year",
            "licence"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "year": {
              "type": "integer"
            },
            "doi": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "licence_checked": {
              "type": "string",
              "description": "Where and when the licence was confirmed."
            },
            "page_basis": {
              "type": "string",
              "description": "What a claim's `page` number means when the source is a PDF, e.g. \"PDF page index; journal page = index + 3139\"."
            }
          }
        },
        "spine": {
          "type": "object",
          "description": "And / But / Therefore: the story reduced to one sentence each, written before any panels.",
          "additionalProperties": false,
          "required": [
            "and",
            "but",
            "therefore"
          ],
          "properties": {
            "and": {
              "type": "string",
              "minLength": 1
            },
            "but": {
              "type": "string",
              "minLength": 1
            },
            "therefore": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "private": {
          "type": "boolean",
          "description": "A private reading aid: the PDF footer on every page says PRIVATE: not for sharing, and the last page says so. Use it for a paper whose licence does not allow adaptation."
        },
        "gallery": {
          "type": "boolean",
          "description": "A catalogue of the renderer's bodies and props, not a comic: the last page prints no adaptation note."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "authors",
              "year",
              "licence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "A short key the claims use in `source.ref`, and the folder name under --pages-root."
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "year": {
                "type": "integer"
              },
              "doi": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "minLength": 1
              },
              "licence_checked": {
                "type": "string",
                "description": "Where and when the licence was confirmed."
              },
              "page_basis": {
                "type": "string",
                "description": "What a claim's `page` number means when the source is a PDF, e.g. \"PDF page index; journal page = index + 3139\"."
              }
            }
          },
          "description": "A comic drawn from several papers (a topic comic). Every claim then names its paper in `source.ref`. Use `source` for a comic about one paper."
        }
      },
      "anyOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "sources"
          ]
        }
      ]
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "look": {
            "type": "string",
            "description": "A short visual description renderers can use."
          },
          "appearance": {
            "type": "object",
            "additionalProperties": false,
            "description": "Hints for renderers that draw characters from structure.",
            "properties": {
              "hair": {
                "enum": [
                  "none",
                  "bob",
                  "long",
                  "ponytail",
                  "bun",
                  "spiky",
                  "beanie",
                  "hardhat"
                ]
              },
              "glasses": {
                "type": "boolean"
              },
              "coat": {
                "type": "boolean",
                "description": "a lab coat over the body"
              },
              "hair_tone": {
                "enum": [
                  "dark",
                  "light",
                  "strands"
                ],
                "description": "dark hair is solid black; light is the same shape as an outline with no fill; strands is a few curved strokes laid over the head (not for spiky hair)"
              },
              "body": {
                "enum": [
                  "stick",
                  "diatom",
                  "krill",
                  "penguin",
                  "whale",
                  "salp",
                  "copepod",
                  "fish",
                  "worm",
                  "jellyfish",
                  "urchin",
                  "seal",
                  "seabird",
                  "moss",
                  "bacterium",
                  "seastar",
                  "dinoflagellate",
                  "squid",
                  "amphipod"
                ]
              },
              "outfit": {
                "enum": [
                  "floatcoat",
                  "parka",
                  "hivis"
                ],
                "description": "A garment over the torso, instead of the lab coat: floatcoat (a chunky float jacket), parka (a quilted jacket with the hood up) or hivis (a high-visibility vest)."
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "kind",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "background",
              "method",
              "result",
              "interpretation",
              "caveat",
              "argument",
              "practice"
            ],
            "description": "argument: what an author contends or theorises (attribute it: 'X argues'); practice: what an author recommends doing; the others suit an empirical paper."
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 1,
                "description": "Section, page, table or 'abstract'."
              },
              "quote": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "description": "The numbered page of the source text where the quote is found (a PDF page, or the paragraph file p007.txt that scripts/fetch_source.py writes); scripts/check_quotes.py checks it."
              },
              "ref": {
                "type": "string",
                "description": "The `id` of the entry in meta.sources this claim comes from (required when the comic has `sources`)."
              }
            }
          },
          "status": {
            "enum": [
              "verified",
              "abstract_only",
              "unverified"
            ],
            "description": "'verified' means checked against the full text."
          },
          "note": {
            "type": "string",
            "description": "Anything a panel must not overstate."
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "act",
          "panels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "act": {
            "enum": [
              "problem",
              "method",
              "result",
              "discussion"
            ]
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "scene"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^B[0-9]+\\.[0-9]+$"
                },
                "scene": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the reader sees."
                },
                "frame": {
                  "enum": [
                    "outlined",
                    "borderless"
                  ],
                  "default": "outlined"
                },
                "speech": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "speaker",
                      "text"
                    ],
                    "properties": {
                      "speaker": {
                        "type": "string",
                        "description": "A cast id, or 'narrator'."
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "say",
                          "think",
                          "caption"
                        ],
                        "default": "say"
                      }
                    }
                  }
                },
                "claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^C[0-9]+$"
                  }
                },
                "humour": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "note"
                  ],
                  "properties": {
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "description": "What the joke is. Absent means no joke."
                    },
                    "keeps_claims_intact": {
                      "type": "boolean",
                      "description": "Set by a reviewer: the joke does not change any claim."
                    }
                  }
                },
                "weight": {
                  "enum": [
                    "small",
                    "standard",
                    "wide",
                    "full"
                  ],
                  "default": "standard",
                  "description": "How much room and time the moment gets, as a preferred share of a row: a third, a half, two thirds or all of it (4, 6, 8 or 12 of 12 units). A wide, quiet panel reads as a pause."
                },
                "transition": {
                  "enum": [
                    "moment-to-moment",
                    "action-to-action",
                    "subject-to-subject",
                    "scene-to-scene",
                    "aspect-to-aspect",
                    "non-sequitur"
                  ],
                  "description": "How this panel follows the previous one (McCloud's six). Not allowed on the first panel."
                },
                "word_picture": {
                  "enum": [
                    "word-specific",
                    "picture-specific",
                    "duo-specific",
                    "additive",
                    "parallel",
                    "montage",
                    "interdependent"
                  ],
                  "description": "How words and picture combine in this panel (McCloud's categories)."
                },
                "staging": {
                  "$ref": "#/$defs/staging"
                },
                "height": {
                  "enum": [
                    "short",
                    "standard",
                    "tall"
                  ],
                  "default": "standard",
                  "description": "How much of a page's spare height this panel's row asks for: a quick beat is short, a significant one is tall. Layout may also vary row heights on its own."
                },
                "device": {
                  "enum": [
                    "gloss",
                    "moment",
                    "close-up",
                    "aside",
                    "reveal"
                  ],
                  "description": "The kind of frame this is, where it is a recognised device: gloss (a character restates a technical term, which a cited definition claim gives, in plain English), moment (the instant itself: the flash firing, the net closing), close-up (an enlargement, cropped by the panel's edge), aside (a wry comment from a character that adds no fact), reveal (the payoff of a sequence). Used to ask for, and count, variety."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional drawing instructions for renderers that draw from structure (positions are fractions of the panel's scene area; x runs left to right, y top to bottom). A renderer that cannot use it falls back to the scene text.",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "A cast id, or 'extra' for an unnamed figure."
              },
              "x": {
                "type": "number",
                "minimum": -0.6,
                "maximum": 1.6,
                "description": "Where the figure stands across the panel, 0 left to 1 right. Beyond 0 or 1 the figure is cropped by the panel's edge, as a very large animal can be."
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "description": "Where the feet stand, 0 top to 1 bottom; default 0.94. Above 1 the feet are below the panel, so a close-up crops the figure."
              },
              "pose": {
                "enum": [
                  "stand",
                  "point",
                  "hold",
                  "think",
                  "shrug",
                  "sip",
                  "up"
                ]
              },
              "face": {
                "enum": [
                  "neutral",
                  "smile",
                  "worry",
                  "deadpan",
                  "surprised"
                ]
              },
              "facing": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "holding": {
                "enum": [
                  "marker",
                  "mug",
                  "clipboard",
                  "teacup",
                  "flask",
                  "magnifier"
                ]
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 8,
                "description": "A multiplier on the figure's size. Use a large one, cropped by the panel's edge, to show the larger of two organisms as larger."
              },
              "body": {
                "enum": [
                  "stick",
                  "diatom",
                  "krill",
                  "penguin",
                  "whale",
                  "salp",
                  "copepod",
                  "fish",
                  "worm",
                  "jellyfish",
                  "urchin",
                  "seal",
                  "seabird",
                  "moss",
                  "bacterium",
                  "seastar",
                  "dinoflagellate",
                  "squid",
                  "amphipod"
                ],
                "description": "draw this character with this body instead of the cast member's (so an `extra` can be an animal)"
              }
            }
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "board",
                  "bars",
                  "paper",
                  "bowl",
                  "picture",
                  "desk",
                  "label",
                  "arrow",
                  "box",
                  "axis",
                  "plot",
                  "pie",
                  "flow",
                  "steps",
                  "stack",
                  "ship",
                  "bottle",
                  "jar",
                  "flash",
                  "cups",
                  "laptop",
                  "microscope",
                  "teapot",
                  "net",
                  "thermometer",
                  "sequence",
                  "tree",
                  "clusters",
                  "network",
                  "database",
                  "filter",
                  "tubes",
                  "sequencer",
                  "cpr",
                  "echosounder",
                  "venn",
                  "satellite",
                  "radar",
                  "icecore",
                  "massspec",
                  "helicopter",
                  "drone",
                  "aquarium",
                  "clay",
                  "mosaic",
                  "freezer",
                  "tag",
                  "scatter",
                  "boxplot",
                  "modelgrid",
                  "radarscreen",
                  "bongo",
                  "trawl",
                  "rmt",
                  "ctd",
                  "map",
                  "currents",
                  "iceberg",
                  "mixedlayer",
                  "seaice",
                  "iceshelf",
                  "stake",
                  "emsled",
                  "fieldcamp",
                  "molecule"
                ]
              },
              "x": {
                "type": "number",
                "minimum": -0.6,
                "maximum": 1.6
              },
              "y": {
                "type": "number",
                "minimum": -0.6,
                "maximum": 1.6
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "h": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "x2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "size": {
                "enum": [
                  "small",
                  "normal",
                  "large"
                ]
              },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "covered": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "bars": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "style": {
                      "enum": [
                        "solid",
                        "hollow"
                      ]
                    }
                  }
                }
              },
              "max": {
                "type": "number"
              },
              "min": {
                "type": "number",
                "description": "bars only: the lowest value on the scale; below zero, bars hang down from the zero line (a signed index)"
              },
              "unit": {
                "type": "string"
              },
              "show_values": {
                "type": "boolean"
              },
              "staging": {
                "$ref": "#/$defs/staging"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "caption": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "to": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "value": {
                      "type": "number"
                    },
                    "style": {
                      "enum": [
                        "solid",
                        "hollow",
                        "mark"
                      ]
                    },
                    "row": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3,
                      "description": "Stack crowded axis labels: raises a mark or bar label, or lowers a tick label, by this many lines."
                    }
                  }
                }
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "points"
                  ],
                  "properties": {
                    "points": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "style": {
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ]
                    }
                  }
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "label"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "x_label": {
                "type": "string"
              },
              "y_label": {
                "type": "string"
              },
              "show_max": {
                "type": "boolean",
                "description": "Print the chart's axis maximum. Turn it off when the maximum is only a drawing choice and not a number from the source."
              },
              "view": {
                "enum": [
                  "polar",
                  "wide"
                ],
                "description": "map and currents only: polar (the south polar cap, to 50 degrees S) or wide (to 10 degrees S, with Australia, New Zealand and the other southern lands)."
              },
              "places": {
                "type": "array",
                "description": "map only: named spots to pin, each with a longitude, a latitude (degrees; south and west negative) and a label.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lon",
                    "lat"
                  ],
                  "properties": {
                    "lon": {
                      "type": "number"
                    },
                    "lat": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "condition": {
                "enum": [
                  "pancake",
                  "pack",
                  "drift",
                  "fast"
                ],
                "description": "seaice only: which ice condition to draw (pancake ice, packed floes, drifting floes with open water, or a sheet of fast ice)."
              },
              "front": {
                "type": "boolean",
                "description": "Draw this prop in front of the characters (for example the glass of a tank, or a desk's edge); props are otherwise behind them."
              }
            }
          }
        }
      }
    }
  }
}
