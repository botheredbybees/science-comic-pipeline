# Settings for the optional card tools (scripts/extract_cards.py, scripts/verify_cards.py). Copy to .env, which git ignores:
#   cp .env.example .env ; set -a; source .env; set +a ; .venv/bin/python scripts/llm.py --ping
# See docs/SETUP.md for what to put here for your own model or hosted service. Nothing here is needed to check, draw or export a comic.

# Which kind of server: ollama, openai (llama.cpp, vLLM, LM Studio, Ollama's /v1, OpenRouter, OpenAI ...) or anthropic
LLM_BACKEND=ollama
# Where it is. Ollama: http://localhost:11434   OpenAI-compatible: http://localhost:8080/v1 (up to and including /v1)
LLM_BASE_URL=http://localhost:11434
# The model that drafts the cards, and a different (preferably larger) one that checks them
LLM_MODEL=
LLM_VERIFY_MODEL=
# Only for a hosted service. Never put a key on a command line or commit it.
LLM_API_KEY=
